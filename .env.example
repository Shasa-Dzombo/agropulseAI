# Application Settings
APP_NAME=AgroPulse
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agropulse
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=agropulse-images
AWS_SAGEMAKER_ENDPOINT=agropulse-ai-model
AWS_BEDROCK_MODEL_ID=anthropic.claude-v2

# Anthropic Claude (direct API, not via AWS Bedrock)
# Powers greenhouse diagnosis vision fallback, treatment recommendations, and chatbot
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5

# Azure Configuration
AZURE_SUBSCRIPTION_KEY=your-azure-key
AZURE_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_QUANTUM_WORKSPACE=your-workspace
AZURE_QUANTUM_RESOURCE_GROUP=your-resource-group

# Blockchain Configuration
BLOCKCHAIN_NETWORK=polygon-mumbai
BLOCKCHAIN_RPC_URL=https://rpc-mumbai.maticvigil.com/
PERMIT_CONTRACT_ADDRESS=0x...
PRIVATE_KEY=your-private-key
GAS_LIMIT=100000

# Payment Gateway (M-Pesa via Flutterwave)
FLUTTERWAVE_PUBLIC_KEY=your-public-key
FLUTTERWAVE_SECRET_KEY=your-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=your-encryption-key
MPESA_SHORTCODE=174379
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret

# Quantum Computing
AMAZON_BRAKET_S3_BUCKET=amazon-braket-outputs
AZURE_QUANTUM_LOCATION=westus

# Redis (for Celery & Caching)
REDIS_URL=redis://localhost:6379/0

# Pricing (in KSh)
DIAGNOSIS_PRICE=50
WEEKLY_SUBSCRIPTION=500
MONTHLY_SUBSCRIPTION=1800
