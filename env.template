# AgroPulse Disease Detection System
# Configuration file for production deployment

# =============================================================================
# ENVIRONMENT PROFILE
# =============================================================================
# Options: development, production, offline, testing
ENVIRONMENT_PROFILE=production

# =============================================================================
# KINDWISE API CONFIGURATION
# =============================================================================
# Get your API key from: https://kindwise.com/
# Provides 288 diseases identification with 85% top-1, 93% top-3 accuracy
KINDWISE_API_KEY=your_kindwise_api_key_here
KINDWISE_BASE_URL=https://crop.kindwise.com/api/v1
KINDWISE_TIMEOUT=30
KINDWISE_MAX_REQUESTS_PER_MINUTE=60
KINDWISE_MAX_REQUESTS_PER_DAY=5000

# =============================================================================
# DETECTION CONFIGURATION
# =============================================================================
# Mode: rule_based, ai_only, hybrid_fast, hybrid_comprehensive, auto
# - rule_based: Local only, offline capable, fast, free
# - ai_only: Kindwise API only, requires internet
# - hybrid_fast: Rule-based first, AI validation if low confidence (recommended)
# - hybrid_comprehensive: Both always, highest accuracy, slower
# - auto: Intelligent routing based on confidence and connectivity
DETECTION_MODE=hybrid_fast

# Minimum confidence for rule-based acceptance (0.0-1.0)
DETECTION_CONFIDENCE_THRESHOLD=0.7

# Enable advanced features
ENABLE_DIFFERENTIAL_DIAGNOSIS=true
ENABLE_RESISTANCE_LOOKUP=true
ENABLE_ECONOMIC_IMPACT=true
ENABLE_FORECASTING=true

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================
# Enable caching to reduce API calls and improve speed
ENABLE_CACHE=true
CACHE_DIR=./detection_cache
KINDWISE_CACHE_DIR=./kindwise_cache

# Cache expiry
CACHE_EXPIRY_HOURS=168  # 7 days
CACHE_MAX_SIZE_MB=1000

# What to cache
CACHE_API_RESPONSES=true
CACHE_IMAGES=false  # Images are large, disable to save space

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_MAX_UPLOAD_SIZE_MB=10
API_RATE_LIMIT_PER_MINUTE=100

# CORS (Cross-Origin Resource Sharing)
API_ENABLE_CORS=true
API_CORS_ORIGINS=*  # Set specific origins in production, e.g., https://yourdomain.com

# Authentication
API_ENABLE_AUTH=false
API_AUTH_TOKEN=  # Set a secure token if authentication is enabled

# =============================================================================
# OUTPUT CONFIGURATION
# =============================================================================
# Format: json, text, pdf
OUTPUT_FORMAT=json

# Language (future support for multiple languages)
OUTPUT_LANGUAGE=en

# What to include in output
OUTPUT_INCLUDE_EPPO_CODES=true
OUTPUT_INCLUDE_TREATMENTS=true
OUTPUT_INCLUDE_CONFIDENCE=true
OUTPUT_FARMER_FRIENDLY=true
OUTPUT_TECHNICAL_DETAILS=false

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_TO_FILE=true

# What to log
LOG_API_CALLS=true
LOG_DETECTIONS=true
LOG_ERRORS=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# GPU acceleration (requires CUDA setup)
ENABLE_GPU=false

# Processing
NUM_WORKERS=4
BATCH_SIZE=1

# =============================================================================
# DATABASE CONFIGURATION (for persistence)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/agropulse

# =============================================================================
# NOTES
# =============================================================================
# 1. This is a template. Copy to .env for your actual configuration
# 2. Never commit .env file with real credentials to version control
# 3. Set KINDWISE_API_KEY to enable AI detection
# 4. Use hybrid_fast mode for best balance of speed, cost, and accuracy
# 5. Enable caching to minimize API costs
# 6. For offline deployment, set DETECTION_MODE=rule_based
